<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppBlockerSecurity.MainPage"
             BackgroundColor="#121212">

    <ScrollView>
        <VerticalStackLayout Padding="30,0" Spacing="25" VerticalOptions="Center">

            <Label 
                Text="🛡️ App Blocker Ativo" 
                FontSize="28" 
                FontAttributes="Bold" 
                HorizontalOptions="Center" 
                TextColor="White"/>
            
            <Label 
                Text="A Inteligência Artificial está monitorando seus apps em segundo plano."
                HorizontalTextAlignment="Center" 
                TextColor="Gray" />
            
            <Label 
                Text="Você já pode fechar esta tela e desconectar o cabo." 
                HorizontalTextAlignment="Center" 
                TextColor="DarkGray" 
                FontSize="14"/>
            
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
