<?xml version="1.0" encoding="utf-8"?>
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagDefault"
    android:canRetrieveWindowContent="false" 
    android:notificationTimeout="50" />
<!-- Configuração do serviço de acessibilidade -->
<!-- O Accessibility Event Types faz com que o serviço receba notificações quando o estado da janela muda -->
<!-- O Accessibility Feedback Type define o tipo de feedback que o serviço irá fornecer -->
<!-- O Accessibility Flags definem os comportamentos do serviço de acessibilidade -->
<!-- O Can Retrieve Window Content indica se o serviço pode recuperar o conteúdo da janela, boa prática para segurança 
para garantir que o seu app saiba qual app foi aberto, mas não consiga ler senhas ou textos na tela dele -->
<!-- O Notification Timeout define o tempo de espera para notificações -->